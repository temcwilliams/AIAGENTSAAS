# Free local setup; generate DATABASE_URL with scripts/init-local.py.
ENVIRONMENT=development
DATABASE_URL=
DATABASE_URL_UNPOOLED=
APP_ORIGIN=http://localhost:3000
AI_PROVIDER=local
OPENAI_BASE_URL=http://127.0.0.1:11434/v1
# No API key needed for local Ollama.
OPENAI_API_KEY=
SESSION_HOURS=12
CHAT_REQUESTS_PER_HOUR=60
# Optional SHA-256 of a random, one-time owner setup token. Never use a password here.
OWNER_SETUP_TOKEN_HASH=
